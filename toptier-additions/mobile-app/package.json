{
  "name": "toptier-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-router": "~3.5.0",
    "expo-linking": "~6.3.1",
    "expo-constants": "~16.0.1",
    "expo-status-bar": "~1.12.1",
    "expo-secure-store": "~13.0.1",
    "expo-notifications": "~0.28.1",
    "expo-local-authentication": "~14.0.0",
    "expo-barcode-scanner": "~13.0.1",
    "expo-haptics": "~13.0.1",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@expo/vector-icons": "^14.0.0",
    "react-native-webview": "13.8.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "eas-cli": "^10.0.0",
    "typescript": "~5.3.3",
    "@types/react": "~18.2.79"
  },
  "private": true,
  "expo": {
    "name": "TOPTIER",
    "slug": "toptier",
    "version": "1.0.0",
    "scheme": "toptier",
    "ios": {
      "bundleIdentifier": "app.toptier.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera used for QR code scanning",
        "NSFaceIDUsageDescription": "Face ID used for secure authentication"
      }
    },
    "android": {
      "package": "app.toptier.mobile",
      "permissions": ["CAMERA", "USE_BIOMETRIC", "USE_FINGERPRINT", "VIBRATE"]
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
