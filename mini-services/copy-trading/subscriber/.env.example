# Subscriber client environment
MT5_LOGIN=your_subscriber_mt5_login
MT5_PASSWORD=your_subscriber_mt5_password
MT5_SERVER=your_subscriber_mt5_server
BACKEND_URL=http://your-backend-host:8000
SUBSCRIBER_API_KEY=the_key_you_received_from_admin
LOT_MULTIPLIER=1.0
MAX_LOT_SIZE=1.0
POLL_SECONDS=2.0

# ─── Risk management settings ────────────────────────────────────────────
# Your account equity in USD (used for risk-normalized sizing, Rule #1)
EQUITY_USD=10000

# Rule #1: Max risk per trade as % of equity (default 2.0%)
MAX_RISK_PER_TRADE_PCT=2.0

# Rule #2: Max concurrent open trades (default 20)
MAX_CONCURRENT_TRADES=20

# Rule #3: Exposure caps (% of equity)
MAX_SYMBOL_EXPOSURE_PCT=20.0
MAX_ASSET_CLASS_EXPOSURE_PCT=40.0

# Rule #4: Weekend crypto cap (% of normal size, applied on weekends)
WEEKEND_CRYPTO_CAP_PCT=50.0

# Rule #4: News blackout — minutes before/after major releases (NFP, CPI, rate decisions)
NEWS_BLACKOUT_MINUTES=30

# Rule #5: Drawdown circuit breakers
DRAWDOWN_SOFT_PAUSE_PCT=8.0      # auto-pause new copies from a provider at this drawdown %
ACCOUNT_WIDE_HARD_STOP_PCT=15.0  # hard-stop ALL trading at this account-wide drawdown %

# ─── Per-asset-class sizing (volatility-adjusted) ───────────────────────
# Forex: lowest volatility → highest lot sizes
FOREX_BASE_LOTS_PER_100=0.02
FOREX_MIN_LOT=0.01
FOREX_MAX_LOTS=15
FOREX_MAX_RISK_PCT=2.0

# Metals: moderate volatility (gold ~$30/day) → half the lots of forex
METALS_BASE_LOTS_PER_100=0.01
METALS_MIN_LOT=0.01
METALS_MAX_LOTS=5
METALS_MAX_RISK_PCT=2.0

# Crypto: highest volatility → conservative lots
CRYPTO_BASE_LOTS_PER_100=0.01
CRYPTO_MIN_LOT=0.02
CRYPTO_MAX_LOTS=5
CRYPTO_MAX_RISK_PCT=1.5
