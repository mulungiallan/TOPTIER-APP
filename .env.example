# ─── TOPTIER Environment Configuration ───────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit real secrets.
# In production, missing required secrets cause the app to fail loudly rather
# than silently fall back to insecure defaults.

# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL="file:../db/custom.db"          # SQLite (or your Postgres URL in prod)
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # Public origin of the app

# ─── Capacitor (Mobile) ──────────────────────────────────────────────────────
# Backend URL baked into the Android/iOS native shell at build time.
# MUST be a public HTTPS URL before Play Store submission.
TOPTIER_BACKEND_URL="https://app.toptier.app"

# ─── Soft Launch ─────────────────────────────────────────────────────────────
# false = payments disabled (checkout routes return 503, UI shows "Notify Me").
# Set to true only after configuring real provider keys below.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# ─── Authentication ──────────────────────────────────────────────────────────
# REQUIRED for production. Signing secret for auth JWTs (at least 32 chars).
NEXTAUTH_SECRET=""
# Alternative name accepted by the auth layer (NEXTAUTH_SECRET takes priority).
JWT_SECRET=""

# ─── Admin Panel Lock ─────────────────────────────────────────────────────────
# Comma-separated emails of the only people allowed to open the Admin Panel
# (on top of the admin/super_admin role in the DB). Leave empty to allow any
# admin-role account; set it in production to restrict to owner-only.
ADMIN_EMAILS=""

# ─── Market Data ─────────────────────────────────────────────────────────────
# Optional. Without it the app falls back to the free Yahoo Finance feed.
FINNHUB_API_KEY=""

# ─── AI / Chart Analysis ─────────────────────────────────────────────────────
# Free-tier providers used as a fallback chain (whichever answers first):
#   1. Hugging Face LLaVA  → 2. Gemini Flash → 3. honest "unable to analyze"
# Configure at least one for real AI chart analysis.
HF_TOKEN=""          # https://huggingface.co/settings/tokens (free)
GEMINI_API_KEY=""    # https://aistudio.google.com/apikey (free)
ANTHROPIC_API_KEY="" # https://console.anthropic.com/ (optional, premium tier)

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Required for password reset + transactional email. Without RESEND_API_KEY the
# app FAILS LOUDLY on email sends (never fakes delivery).
RESEND_API_KEY=""
EMAIL_FROM="notifications@toptier.app"

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
STRIPE_PRICE_LIFETIME=""

# ─── PayPal ──────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_ENVIRONMENT="sandbox"   # sandbox | production

# ─── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# ─── Flutterwave ─────────────────────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=""
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=""

# ─── M-Pesa (Daraja) ─────────────────────────────────────────────────────────
# All three are REQUIRED for M-Pesa payments (no hardcoded fallbacks).
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_ENVIRONMENT="sandbox"    # sandbox | production

# ─── RevenueCat (mobile subscriptions) ───────────────────────────────────────
REVENUECAT_SECRET_KEY=""
NEXT_PUBLIC_REVENUECAT_PUBLIC_KEY=""
REVENUECAT_IOS_MONTHLY=""
REVENUECAT_IOS_ANNUAL=""
REVENUECAT_IOS_LIFETIME=""
REVENUECAT_ANDROID_MONTHLY=""
REVENUECAT_ANDROID_ANNUAL=""
REVENUECAT_ANDROID_LIFETIME=""

# ─── Binance (live broker connect) ───────────────────────────────────────────
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
# Keep withdrawals OFF ("false") unless automatic USDT payouts are intended.
# When ON, submitted payouts are auto-submitted to Binance and reconciled
# against the withdrawal history on every payout page load (processing -> paid
# on completion, -> failed on rejection/failure).
BINANCE_WITHDRAWALS_ENABLED=false

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate keys with: npx web-push generate-vapid-keys
# Public key is inlined into the client bundle; private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:notifications@toptier.app"   # mailto: contact for the push service

# ─── Sentry (Error Tracking) ─────────────────────────────────────────────────
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_REPLAYS_SESSION_SAMPLE_RATE="0.0"
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE="0.0"

# ─── Auto-Trading Bot (MT5/MT4) ─────────────────────────────────────────────
# Local Python service (mini-services/bot/server.py, run: uvicorn server:app).
BOT_SERVICE_URL="http://127.0.0.1:8765"
# Shared secret used BOTH directions: app -> bot service, and the bot service
# -> the /api/bot/webhook route. Use a long random string; keep it identical
# in the app and in the bot service's environment.
BOT_SERVICE_KEY=""
# Secret used to encrypt MetaTrader account passwords at rest (at least 32
# chars, e.g. your NEXTAUTH_SECRET). REQUIRED in production.
BOT_CREDENTIALS_SECRET=""

# ─── Referral Gate (bot + copy trading are invite-only) ─────────────────────
# Bot trading and copy trading only work for users who signed up through a
# referral link (they carry a referredBy referrer). Admins are always exempt.
#   REFERRAL_LOCK_ENABLED=false   -> disable the gate entirely (default: on)
#   REFERRAL_LOCK_CODE="ABC123"   -> only users referred by THIS code unlock
#   REFERRAL_LOCK_URL="https://app.toptier.app/register?ref=ABC123" -> the
#     referral link shown on the lock screen so users can get access.
REFERRAL_LOCK_ENABLED=true
REFERRAL_LOCK_CODE=""
REFERRAL_LOCK_URL=""

# ─── Broker Referral Link ────────────────────────────────────────────────────
# Shown to users who need an MT5/MT4 account (Trading Bot + Copy Trading pages).
NEXT_PUBLIC_BROKER_REFERRAL_URL=""
