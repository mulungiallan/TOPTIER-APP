// --- Copy trading: provider registration + profit settlement ---------------

model CopyTrader {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle         String  @unique
  bio            String?
  copyFeePct     Float   @default(50) // trader's cut of follower profits (50%)
  platformFeePct Float   @default(10) // TOPTIER's cut of follower profits (copy-trading money goes to the broker, not Binance)
  status         String  @default("approved") // pending | approved | rejected | disabled
  totalFollowers Int     @default(0)
  realizedPnl    Float   @default(0)

  // Copy-trading eligibility + lot sizing policy.
  minAccountBalanceUsd Float @default(100) // followers need at least this account size (min $100)
  lotsPer100Usd        Float @default(0.01) // base lot per $100 of follower equity (progressive, legacy fallback)

  // ─── Per-asset-class sizing (lot sizes vary by pair type) ───────────────
  // Forex: most liquid, lowest risk per lot → most lots
  // Metals: gold/silver higher notional per lot → reduced lots
  // Crypto: highest volatility → most conservative lots
  // Forex: lowest volatility → highest lot sizes relative to equity
  forexBaseLotsPer100Usd  Float @default(0.02) // base lots per $100 for currency pairs
  forexMinLotSize         Float @default(0.01) // minimum lot for forex
  forexMaxLots            Float @default(15) // max lots per forex trade
  forexMaxRiskPct         Float @default(2.0) // max risk per trade % for forex
  // Metals: moderate volatility (gold ~$30/day) → half the lots of forex
  metalsBaseLotsPer100Usd Float @default(0.01) // base lots per $100 for metals
  metalsMinLotSize        Float @default(0.01) // minimum lot for metals
  metalsMaxLots           Float @default(5) // max lots per metals trade
  metalsMaxRiskPct        Float @default(2.0) // max risk per trade % for metals
  // Crypto: highest volatility → conservative lots
  cryptoBaseLotsPer100Usd Float @default(0.01) // base lots per $100 for crypto
  cryptoMinLotSize        Float @default(0.02) // minimum lot for crypto
  cryptoMaxLots           Float @default(5) // max lots per crypto trade
  cryptoMaxRiskPct        Float @default(1.5) // max risk per trade % for crypto

  // PAMM/MAM managed-account mode. masterConnectionId points at a BotConnection
  // owned by this trader that the bot trades as the MASTER; followers allocate
  // capital and copy it. The provider's 50% profit share is paid into the
  // trader's BROKER account (the master MT account) — never through the app's
  // Binance payout. brokerAccount* caches the MT account the broker pays into.
  masterConnectionId String?        @unique
  masterConnection   BotConnection? @relation("BotMasterConnection", fields: [masterConnectionId], references: [id], onDelete: SetNull)
  brokerSettled      Boolean        @default(true)
  minAllocationPct   Float          @default(1)
  maxAllocationPct   Float          @default(100)
  brokerAccountLabel String?
  brokerAccountLogin String?

  // ─── Risk management (from copytrading feature.txt) ─────────────────────
  // Rule #1: Position sizing — hard per-trade risk cap (default 2% of master equity).
  maxRiskPerTradePct       Float     @default(2.0)
  // Rule #2: Max concurrent open trades per provider (prevents scalper from
  //          eating all margin; swing traders get their fair share).
  maxConcurrentTrades      Int       @default(20)
  // Rule #2: Margin reservation budget per provider (% of follower equity).
  marginBudgetPct          Float     @default(100)
  // Rule #5: Drawdown circuit breakers.
  drawdownSoftPausePct     Float     @default(8.0) // per-provider: auto-pause at -8% of allocated slice
  accountWideHardStopPct   Float     @default(15.0) // account-wide: pause ALL providers at -15% in rolling week
  // Rule #3: Correlation and conflict — per-symbol net exposure cap (% of master equity).
  maxSymbolExposurePct     Float     @default(20.0)
  // Rule #3: Per-asset-class (forex/metals/crypto) net exposure cap.
  maxAssetClassExposurePct Float     @default(40.0)
  // Rule #4: Weekend/gap rule — tighter crypto cap on weekends (% of normal cap).
  weekendCryptoCapPct      Float     @default(50.0)
  // Rule #4: News blackout — minutes before/after major releases for metals/forex.
  newsBlackoutMinutes      Int       @default(30)
  // Rule #6: Rebalancing — last time provider weights were recalculated.
  lastRebalanceAt          DateTime?
  // Rule #7: Reconciliation — last daily drift check.
  lastReconcileAt          DateTime?
  // Circuit breaker state: tracks current drawdown and whether hard stop is active.
  currentDrawdownPct       Float     @default(0)
  hardStopActive           Boolean   @default(false)
  hardStopActivatedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlements CopySettlement[]

  @@index([status])
}

// Rule #5: Drawdown and circuit breaker event log — tracks per-provider soft
// pauses and account-wide hard stops for audit and automatic recovery.
model CopyRiskEvent {
  id           String   @id @default(cuid())
  traderId     String // CopyTrader.id
  followerId   String? // User.id — null for account-wide events
  eventType    String // provider_soft_pause | provider_resume | account_hard_stop | account_resume
  symbol       String? // relevant symbol if event is symbol-specific
  drawdownPct  Float // the drawdown % that triggered the event
  thresholdPct Float // the threshold that was crossed
  details      String? // JSON metadata
  createdAt    DateTime @default(now())

  @@index([traderId, createdAt])
  @@index([eventType])
}

model CopySettlement {
  id             String         @id @default(cuid())
  traderId       String
  trader         CopyTrader     @relation(fields: [traderId], references: [id], onDelete: Cascade)
  followerId     String
  follower       User           @relation(fields: [followerId], references: [id], onDelete: Cascade)
  copyTradeId    String?
  grossProfit    Float
  providerFeePct Float          @default(30)
  platformFeePct Float          @default(10)
  providerAmount Float
  platformAmount Float
  status         String         @default("due") // due | paid | cancelled
  paidAt         DateTime?
  // dedicatedAt = the moment the provider's fee was locked in on a take-profit
  // hit (every profitable close — whatever the number of TP levels taken —
  // dedicates the fee immediately and is never reduced by later losses).
  dedicatedAt    DateTime?
  // PAMM/MAM provenance: which master account produced this, and how the fee
  // is collected. settledBy: manual | broker | platform.
  connectionId   String?
  connection     BotConnection? @relation("CopySettlementConnection", fields: [connectionId], references: [id], onDelete: SetNull)
  settledBy      String         @default("manual")
  source         String         @default("copy") // copy | master
  createdAt      DateTime       @default(now())

  @@index([traderId, status])
  @@index([followerId])
  @@index([connectionId])
}
