generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  password              String
  name                  String?
  phone                 String?
  profilePicture        String?
  dateOfBirth           String?
  country               String?
  role                  String    @default("user") // user, admin, super_admin, moderator, support, analyst
  subscriptionTier      String    @default("free") // free, trial, premium, lifetime
  trialStartDate        DateTime?
  trialEndDate          DateTime?
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  isEmailVerified       Boolean   @default(false)
  twoFactorEnabled      Boolean   @default(false)
  twoFactorSecret       String?
  onboardingCompleted   Boolean   @default(false)
  onboardingStep        Int       @default(0)
  referralCode          String    @unique
  referredBy            String?
  referralCount         Int       @default(0)
  earnedPremiumDays     Int       @default(0)

  // ─── Premium Package System ────────────────────────────────────────
  // `plan` is the authoritative field for the new packages system
  // (free | starter | premium | pro | enterprise | unlimited)
  // `subscriptionTier` (above) is kept for legacy compat / older UI flows.
  plan             String     @default("free")
  analysesLimit    Int        @default(5) // 0 = unlimited
  analysesUsed     Int        @default(0)
  analysesResetAt  DateTime?
  planExpiresAt    DateTime?
  stripeCustomerId String?
  orders           Order[]
  analyses         Analysis[]

  tradingStyle      String? // scalp, swing, both
  riskLevel         String? // conservative, moderate, aggressive
  preferredMarkets  String? // comma-separated: forex,crypto,stocks,indices,commodities
  preferredSessions String? // comma-separated: asian,european,us
  notificationPrefs String? // JSON string
  language          String    @default("en")
  darkMode          Boolean   @default(true)
  analyticsOptOut   Boolean   @default(false)
  isBanned          Boolean   @default(false)
  banReason         String?
  tokenVersion      Int       @default(0)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  signals             Signal[]
  screenshotAnalyses  ScreenshotAnalysis[]
  watchlists          Watchlist[]
  priceAlerts         PriceAlert[]
  customAlerts        CustomAlert[]
  signalFilters       SignalFilter[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
  badges              UserBadge[]
  bookmarkedArticles  BookmarkedArticle[]
  calendarReminders   CalendarReminder[]
  signalComments      SignalComment[]
  signalReactions     SignalReaction[]
  supportTickets      SupportTicket[]
  reviews             Review[]
  paymentTransactions PaymentTransaction[]
  referralRewards     ReferralReward[]
  educationProgress   EducationProgress[]
  consentRecords      ConsentRecord[]

  // ─── Batch 2: Social / Trading / AI models ────────────────────────────
  following            Follow[]              @relation("FollowFollower")
  followers            Follow[]              @relation("FollowFollowing")
  posts                Post[]
  postLikes            PostLike[]
  postComments         Comment[]
  conversationsP1      Conversation[]        @relation("ConvP1")
  conversationsP2      Conversation[]        @relation("ConvP2")
  directMessages       DirectMessage[]
  groupsOwned          Group[]               @relation("GroupOwner")
  groupMemberships     GroupMember[]
  competitionsCreated  Competition[]         @relation("CompCreator")
  competitionEntries   CompetitionEntry[]
  paperTrades          PaperTrade[]
  copyTradesExecuted   CopyTrade[]           @relation("CopyFollower")
  copyTradesTriggered  CopyTrade[]           @relation("CopyTrader")
  pricePredictions     PricePrediction[]
  backtests            Backtest[]
  patternDetections    PatternDetection[]
  strategies           Strategy[]
  pushSubscriptions    PushSubscription[]
  biometricCredentials BiometricCredential[]

  // ─── Auto-trading bot (MT5/MT4) ────────────────────────────────────────
  botConnections BotConnection[]
  botInstances   BotInstance[]
  botTrades      BotTrade[]
  botSettlements BotProfitShare[]

  // ─── App usage tracking ────────────────────────────────────────────────
  usageSessions UsageSession[]
  usageEvents   UsageEvent[]

  copyTraderProfile CopyTrader?
  copySettlements   CopySettlement[]
}

model Signal {
  id              String    @id @default(cuid())
  type            String // BUY, SELL, NEUTRAL
  asset           String
  entryPrice      Float
  stopLoss        Float
  takeProfit1     Float
  takeProfit2     Float?
  takeProfit3     Float?
  trailingStop    Float?
  riskRewardRatio Float
  confidence      Int // 0-100
  strategy        String // scalp, swing
  timeframe       String
  reason          String
  status          String    @default("active") // active, hit_tp, hit_sl, expired, ignored
  resultPrice     Float?
  resultType      String? // tp1, tp2, tp3, sl, expired
  expiryDate      DateTime
  marketType      String // forex, crypto, stocks, indices, commodities
  tradingSession  String? // asian, european, us
  generatedAt     DateTime  @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  comments  SignalComment[]
  reactions SignalReaction[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ScreenshotAnalysis {
  id            String   @id @default(cuid())
  userId        String
  imageUrl      String
  signalType    String? // BUY, SELL, NEUTRAL
  entryPrice    Float?
  stopLoss      Float?
  takeProfit1   Float?
  takeProfit2   Float?
  takeProfit3   Float?
  confidence    Int?
  timeframe     String?
  detectedAsset String?
  pattern       String?
  explanation   String?
  status        String   @default("pending") // pending, completed, failed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id])
  items WatchlistItem[]
}

model WatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  asset       String
  assetName   String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, asset])
}

model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  asset       String
  alertType   String // above, below, crosses
  targetPrice Float
  isRecurring Boolean   @default(false)
  isActive    Boolean   @default(true)
  isTriggered Boolean   @default(false)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CustomAlert {
  id          String    @id @default(cuid())
  userId      String
  asset       String
  alertType   String // rsi, macd, ma_cross, volume_spike, support_resistance
  condition   String // JSON with threshold params
  isActive    Boolean   @default(true)
  isTriggered Boolean   @default(false)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SignalFilter {
  id             String   @id @default(cuid())
  userId         String
  marketTypes    String? // comma-separated
  assets         String? // comma-separated
  strategies     String? // comma-separated
  sessions       String? // comma-separated
  minConfidence  Int      @default(50)
  maxSignalsHour Int?
  maxSignalsDay  Int?
  mutedAssets    String? // comma-separated
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // signal, signal_result, news, calendar, price_alert, custom_alert, system, subscription, referral
  title     String
  message   String
  isRead    Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  details    String?
  ipAddress  String?
  deviceInfo String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeType String
  badgeName String
  earnedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model BookmarkedArticle {
  id         String   @id @default(cuid())
  userId     String
  articleUrl String
  title      String
  source     String?
  savedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CalendarReminder {
  id              String   @id @default(cuid())
  userId          String
  eventId         String
  eventName       String
  eventDate       DateTime
  reminderMinutes Int // 5, 15, 30, 60
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, eventDate])
}

model SignalComment {
  id        String   @id @default(cuid())
  signalId  String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([signalId])
  @@index([userId])
}

model SignalReaction {
  id        String   @id @default(cuid())
  signalId  String
  userId    String
  reaction  String // thumbs_up, thumbs_down
  createdAt DateTime @default(now())

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([signalId, userId])
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  description String
  category    String // bug, feature_request, improvement, praise, complaint, support
  status      String   @default("open") // open, in_progress, resolved, closed
  priority    String   @default("medium") // low, medium, high, critical
  attachments String? // JSON string array of data-URL images
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  rating    Int // 1-5
  title     String?
  comment   String?
  category  String   @default("general") // general, signals, analysis, support, app
  status    String   @default("pending") // pending, approved, rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PaymentTransaction {
  id              String   @id @default(cuid())
  userId          String
  amount          Float
  currency        String   @default("USD")
  planType        String // premium_monthly, premium_annual, lifetime
  paymentMethod   String?
  paymentProvider String? // stripe, revenuecat
  status          String   @default("pending") // pending, completed, failed, refunded
  stripeSessionId String?
  invoiceUrl      String?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model ReferralReward {
  id             String   @id @default(cuid())
  userId         String // the referrer
  referredUserId String? // the person who was referred
  rewardType     String // premium_days
  rewardAmount   Int // number of days
  status         String   @default("pending") // pending, granted, revoked
  reason         String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model EducationProgress {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  contentType String // guide, glossary, video, quiz
  completed   Boolean  @default(false)
  score       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ConsentRecord {
  id          String    @id @default(cuid())
  userId      String
  consentType String // terms, privacy, cookies, analytics, marketing
  granted     Boolean
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Public data-deletion requests (GDPR/CCPA/Google Play). Submitted from a
// public web form by an email address; intentionally NOT linked to the User
// table so requests can be made after account deletion or before login.
model DataDeletionRequest {
  id        String   @id @default(cuid())
  email     String
  requestType String @default("delete") // delete, export
  reason    String?
  status    String   @default("pending") // pending, in_progress, completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, status])
}

model EconomicEvent {
  id            String   @id @default(cuid())
  eventName     String
  eventDate     DateTime
  currency      String
  impactLevel   String // high, medium, low
  previousValue String?
  forecastValue String?
  actualValue   String?
  eventType     String? // central_bank, employment, inflation, gdp, etc.
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventDate])
  @@index([currency])
}

model NewsArticle {
  id           String    @id @default(cuid())
  title        String
  summary      String?
  content      String?
  source       String
  url          String?
  sentiment    String? // bullish, bearish, neutral
  taggedAssets String? // comma-separated
  category     String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([publishedAt])
  @@index([category])
}

model CouponCode {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String // percentage, fixed
  discountAmount Float
  maxUses        Int?
  usedCount      Int       @default(0)
  maxPerUser     Int?
  expiresAt      DateTime?
  minPlan        String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
}

// ─── Premium Package System ─────────────────────────────────────────────────
// Packages define sellable plans (Starter, Premium, Pro, Enterprise, Unlimited).
// Orders track individual purchases. Analyses track per-analysis audit trail.

model Package {
  id            String   @id @default(cuid())
  name          String   @unique // "Starter", "Premium", "Pro", "Enterprise", "Unlimited", "Starter Annual", ...
  description   String?
  duration      String // "monthly", "quarterly", "annual"
  price         Float // 19.99, 29.99, etc.
  analyses      Int // 50, 100, 200, 500, 0 (0 = unlimited)
  splitRatio    Int      @default(90) // % of analyses that go to premium API
  features      String // JSON-encoded array of feature strings
  isActive      Boolean  @default(true)
  isPopular     Boolean  @default(false)
  stripePriceId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]
}

model Order {
  id                   String   @id @default(cuid())
  userId               String
  packageId            String
  package              Package  @relation(fields: [packageId], references: [id])
  amount               Float
  currency             String   @default("USD")
  status               String   @default("pending") // pending, paid, expired, cancelled, refunded
  analysesUsed         Int      @default(0)
  analysesLimit        Int
  startDate            DateTime
  endDate              DateTime
  stripeSessionId      String?
  stripePaymentId      String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([stripeSessionId])
}

model Analysis {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  imageHash  String? // MD5 of source image (for dedup)
  imageUrl   String?
  analysis   String // JSON-encoded analysis result
  planUsed   String // "free", "premium", "ensemble"
  cost       String // "$0.00", "$0.013", etc.
  method     String // "huggingface", "replicate", "heuristic", "ensemble"
  pattern    String?
  signal     String?
  confidence Int?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// BATCH 2 MODELS — Social, Trading, AI, Internationalization, Security
// ═══════════════════════════════════════════════════════════════════════════

// ─── Social: Follow / Copy Trading ──────────────────────────────────────────

model Follow {
  id              String   @id @default(cuid())
  followerId      String
  followingId     String
  autoCopy        Boolean  @default(false)
  copyRatio       Float    @default(1.0)
  maxPositionSize Float    @default(1000)
  createdAt       DateTime @default(now())

  follower  User @relation("FollowFollower", fields: [followerId], references: [id])
  following User @relation("FollowFollowing", fields: [followingId], references: [id])

  // PAMM-style capital allocation: % of the follower's equity exposed to the
  // manager's master account. active | paused.
  allocationPct Float  @default(10)
  status        String @default("active")

  // Copy-trading eligibility: the follower must run an account of at least the
  // trader's minimum size (min $100) and must agree to the Copy Trading Terms &
  // Conditions before any trade is mirrored. declaredBalanceUsd drives the
  // progressive lot sizing.
  declaredBalanceUsd Float?
  termsAccepted      Boolean   @default(false)
  termsAcceptedAt    DateTime?

  // Broker account link: the follower's MT4/MT5 BotConnection used for
  // PAMM/MAM copy execution. When set, mirrorMasterOpen/Close can reference
  // the follower's real broker account for position tracking.
  connectionId String?
  connection   BotConnection? @relation("FollowerConnection", fields: [connectionId], references: [id], onDelete: SetNull)

  // Risk management: track concurrent open trades and allocated margin per provider
  // to enforce per-provider caps and margin reservation (rule #2 from feature spec).
  concurrentTradeCount Int   @default(0)
  allocatedMarginUsd   Float @default(0)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([connectionId])
}

model CopyTrade {
  id             String    @id @default(cuid())
  followerId     String
  traderId       String
  sourceSignalId String?
  symbol         String
  direction      String // BUY, SELL
  size           Float
  entryPrice     Float
  stopLoss       Float?
  takeProfit     Float?
  status         String    @default("open") // open, closed, cancelled
  exitPrice      Float?
  pnl            Float?
  allocationPct  Float     @default(10) // follower's capital exposure at copy time
  masterTicket   String? // ticket on the master account this mirrors (null for manual/signal copies)
  source         String    @default("signal") // signal | master
  createdAt      DateTime  @default(now())
  closedAt       DateTime?

  // Risk management: track risk % at copy time for reconciliation and drift detection.
  // providerRiskPct = provider's risk as % of THEIR equity (lot * pipValue * SL distance / providerEquity).
  // masterRiskPct   = the replicated % risk applied against the master account's equity.
  // assetClass       = forex | metals | crypto — used for per-asset-class exposure caps (rule #3).
  providerRiskPct Float?
  masterRiskPct   Float?
  assetClass      String?

  follower User @relation("CopyFollower", fields: [followerId], references: [id])
  trader   User @relation("CopyTrader", fields: [traderId], references: [id])

  @@index([followerId, status])
  @@index([traderId, createdAt])
  @@index([masterTicket])
  @@index([symbol, status])
}

// ─── Social: Feed / Posts / Comments / Likes ────────────────────────────────

model Post {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  content     String
  type        String   @default("general") // signal, analysis, general, question
  attachments String? // JSON-encoded array of URLs
  tags        String? // comma-separated
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  visibility  String   @default("public") // public, followers, private
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  postLikes    PostLike[]
  postComments Comment[]

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

// ─── Social: Direct Messaging ───────────────────────────────────────────────

model Conversation {
  id             String   @id @default(cuid())
  participant1Id String
  participant2Id String
  participant1   User     @relation("ConvP1", fields: [participant1Id], references: [id])
  participant2   User     @relation("ConvP2", fields: [participant2Id], references: [id])
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  messages DirectMessage[]

  @@unique([participant1Id, participant2Id])
  @@index([participant2Id, lastMessageAt])
}

model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ─── Social: Groups ─────────────────────────────────────────────────────────

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation("GroupOwner", fields: [ownerId], references: [id])
  category    String   @default("trading") // trading, education, signals, discussion
  isPrivate   Boolean  @default(false)
  memberCount Int      @default(1)
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GroupMember[]

  @@index([category, createdAt])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  role     String   @default("member") // owner, admin, member
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

// ─── Social: Leaderboards / Competitions ────────────────────────────────────

model Competition {
  id              String   @id @default(cuid())
  name            String
  description     String?
  creatorId       String
  creator         User     @relation("CompCreator", fields: [creatorId], references: [id])
  type            String   @default("win_rate") // win_rate, profit, volume, accuracy
  startDate       DateTime
  endDate         DateTime
  entryFee        Float    @default(0)
  prizePool       Float    @default(0)
  maxParticipants Int?
  status          String   @default("upcoming") // upcoming, active, ended, cancelled
  createdAt       DateTime @default(now())

  entries CompetitionEntry[]

  @@index([status, startDate])
}

model CompetitionEntry {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  score         Float       @default(0)
  rank          Int?
  joinedAt      DateTime    @default(now())

  @@unique([competitionId, userId])
  @@index([userId])
}

// ─── Trading: Paper Trading ─────────────────────────────────────────────────

model PaperTrade {
  id         String    @id @default(cuid())
  userId     String
