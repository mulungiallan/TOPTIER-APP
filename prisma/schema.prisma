// ═══════════════════════════════════════════════════════════════════════════
// AUTO-TRADING BOT — MetaTrader 5 / MetaTrader 4 integration
//
// Flow: a user links an MT4/MT5 account (BotConnection) → the app starts a
// server-side bot instance (BotInstance) → the Python bot service trades the
// account → closed trades are pushed back through /api/bot/webhook and stored
// as BotTrade → a configurable provider profit share is tracked and settled in
// BotProfitShare. TOPTIER earns providerSharePct% of EVERY winning trade —
// both long and short — with no high-water mark or loss carry-forward.
// ═══════════════════════════════════════════════════════════════════════════

model BotConnection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform        String // "mt5" | "mt4"
  label           String // user-friendly name, e.g. "My JustMarkets demo"
  brokerName      String? // e.g. "JustMarkets", "IC Markets"
  login           String
  passwordEnc     String // AES-256-GCM ciphertext (see src/lib/bot-crypto.ts)
  server          String
  terminalPath    String? // optional path to terminal64.exe / terminal.exe
  accountCurrency String? // reported by the platform on connect, cached here

  // Runtime + trading configuration (JSON string, mirrors engine config.py knobs)
  settings        String @default("{}")
  riskPerTradePct Float  @default(1.0) // convenience override of settings.risk

  // Profit-share accounting (per winning trade: long and short)
  realizedPnl           Float @default(0) // cumulative closed-trade P/L for this account
  grossProfit           Float @default(0) // cumulative winning-trade profit (BUY + SELL)
  settledProviderAmount Float @default(0) // provider share already settled (cumulative)
  providerSharePct      Float @default(50) // % of each winning trade's profit owed to TOPTIER

  isActive        Boolean   @default(true)
  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // PAMM/MAM managed-account mode: when a CopyTrader designates this account
  // as its MASTER, the bot trades here and followers' allocations copy it.
  masterTrader CopyTrader? @relation("BotMasterConnection")

  instances       BotInstance[]
  trades          BotTrade[]
  settlements     BotProfitShare[]
  copySettlements CopySettlement[] @relation("CopySettlementConnection")
  followerCopies  Follow[]         @relation("FollowerConnection")

  @@index([userId])
}

model BotInstance {
  id           String        @id @default(cuid())
  connectionId String
  connection   BotConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  status          String    @default("stopped") // stopped | starting | running | stopping | error
  pid             Int? // OS process id of the python runner on the bot service
  lastHeartbeatAt DateTime?
  lastSnapshot    String? // latest status snapshot JSON pushed by the bot service
  lastError       String?
  startCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([connectionId])
  @@index([userId, status])
}

model BotTrade {
  id           String        @id @default(cuid())
  connectionId String
  connection   BotConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticket       String
  symbol       String
  timeframe    String?
  direction    String // BUY | SELL
  lots         Float
  entryPrice   Float
  closePrice   Float?
  stopLoss     Float?
  takeProfit   Float?
  profit       Float
  result       String? // WIN | LOSS | BREAKEVEN
  strategyData String?
  riskAmount   Float?
  openedAt     DateTime
  closedAt     DateTime?

  createdAt DateTime @default(now())

  @@unique([connectionId, ticket])
  @@index([userId, closedAt])
  @@index([connectionId, closedAt])
}

model BotProfitShare {
  id           String        @id @default(cuid())
  connectionId String
  connection   BotConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  periodStart      DateTime
  periodEnd        DateTime
  grossProfit      Float // winning trades total
  grossLoss        Float // losing trades total (positive number)
  netProfit        Float // grossProfit - grossLoss
  providerSharePct Float     @default(50)
  providerAmount   Float // share of the period's winning trades, per-trade model
  lossCarryforward Float     @default(0) // legacy — always 0 (no carry-forward in per-trade model)
  status           String    @default("due") // due | paid | cancelled
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, status])
  @@index([connectionId, createdAt])
}

