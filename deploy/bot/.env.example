# deploy/bot/.env.example
# Copy to .env on the Windows VPS (or let install.ps1 write it for you).
#
# BOT_SERVICE_KEY MUST be identical to the app's BOT_SERVICE_KEY.

BOT_SERVICE_KEY=replace-with-the-same-long-secret-as-the-app
BOT_SERVICE_HOST=127.0.0.1
BOT_SERVICE_PORT=8765
BOT_ENGINE_DIR=C:\app\mt5_trading_bot
BOT_DATA_DIR=C:\app\mini-services\bot\data
BOT_PYTHON=python
